---
// Vollständige Ausgabe unter stabiler URL /ausgabe/JJJJ-MM-TT-{slot}/
import Base from "../../layouts/Base.astro";
import MarketTiles from "../../components/MarketTiles.astro";
import Article from "../../components/Article.astro";
import BranchenMonitor from "../../components/BranchenMonitor.astro";
import StockPicks from "../../components/StockPicks.astro";
import Watchlist from "../../components/Watchlist.astro";
import RessortKopf from "../../components/RessortKopf.astro";
import { getAllEditions, getLatestEdition } from "../../lib/editions.mjs";
import { formatDateLong, slotLabel } from "../../lib/format.mjs";

export function getStaticPaths() {
  return getAllEditions().map(({ slug, data }) => ({ params: { slug }, props: { data } }));
}

const { data } = Astro.props;
const { slug } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Ältere Ausgabe: Hinweis mit Weg zur aktuellen Ausgabe. Die Rubriken im Kopf und im Dock
// springen zu den Abschnitten dieser Seite (Anker mit den Namen der Rubriken).
const archiv = getLatestEdition().slug !== slug;
const leitartikel = data.articles.filter((a) => a.ressort === "titelseite");
const news = data.articles.filter((a) => a.ressort === "news" || a.ressort === "makro");
const politik = data.articles.filter((a) => a.ressort === "politik");
const unternehmen = data.articles.filter((a) => a.ressort === "unternehmen");
---

<Base title={`Ausgabe ${data.edition.date} (${slotLabel(data.edition.slot)})`} edition={data.edition} ausgabe={slug}>
  <div id="titelseite" class="anker"></div>
  {archiv && (
    <p class="archiv-hinweis">Archivausgabe vom {formatDateLong(data.edition.date)}. <a href={`${base}/`}>Zur aktuellen Ausgabe</a></p>
  )}
  <MarketTiles tiles={data.market.tiles} />

  {leitartikel.map((a) => <Article article={a} lead={true} />)}

  <div id="news" class="anker"></div>
  {news.length > 0 && (
    <>
      <RessortKopf titel="News" />
      {news.map((a) => <Article article={a} />)}
    </>
  )}

  <div id="politik" class="anker"></div>
  {politik.length > 0 && (
    <>
      <RessortKopf titel="Politik" />
      {politik.map((a) => <Article article={a} />)}
    </>
  )}

  <div id="branchen-monitor" class="anker"></div>
  <RessortKopf titel="Branchen-Monitor" />
  <BranchenMonitor monitor={data.branchenMonitor} />

  <div id="unternehmen" class="anker"></div>
  {unternehmen.length > 0 && (
    <>
      <RessortKopf titel="Unternehmen" />
      {unternehmen.map((a) => <Article article={a} />)}
    </>
  )}

  <div id="drei-aktien" class="anker"></div>
  <RessortKopf titel="Drei Aktien des Tages" />
  <StockPicks picks={data.stockPicks} />

  {data.watchlist.length > 0 && (
    <>
      <RessortKopf titel="Watchlist" />
      <Watchlist items={data.watchlist} />
    </>
  )}

  <div id="lernecke" class="anker"></div>
  <RessortKopf titel="Lernecke" />
  <ol class="lernpunkte">
    {data.learningNotes.map((note) => <li>{note}</li>)}
  </ol>
  {data.lernecke && data.lernecke.length > 0 && (
    <>
      <RessortKopf titel="Vertiefung: Die Modelle dahinter" />
      <div class="lernecke-vertiefung">
        {data.lernecke.map((entry) => (
          <article class="karte lernecke-modell">
            <h3 class="lernecke-modell__titel">
              <span class="lernecke-modell__disziplin">{entry.disziplin}</span>
              {entry.modell}
            </h3>
            <div class="mechanik-box">
              <span class="mechanik-box__titel">Das Modell</span>
              {entry.erklaerung}
            </div>
            <div class="mechanik-box" style="margin-bottom:0">
              <span class="mechanik-box__titel">Angewendet auf diese Ausgabe</span>
              {entry.anwendung}
            </div>
          </article>
        ))}
      </div>
    </>
  )}
  {data.financeLink && (
    <article class="karte finance-link" style="margin-top:26px">
      <h3 style="margin-top:0; font-family:var(--display)">{data.financeLink.titel}</h3>
      {data.financeLink.absaetze.map((p) => <p>{p}</p>)}
      <aside class="mechanik-box" style="margin-bottom:0">
        <span class="mechanik-box__titel">Typischer Anfängerfehler</span>
        {data.financeLink.anfaengerfehler.replace(/^Der typische Anfängerfehler:\s*/i, "")}
      </aside>
    </article>
  )}
  <dl class="glossar" style="margin-top:26px">
    {data.glossar.map((g) => (
      <>
        <dt>{g.begriff}</dt>
        <dd>{g.erklaerung}</dd>
      </>
    ))}
  </dl>
</Base>
