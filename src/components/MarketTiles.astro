---
// Märkte im Überblick: Kacheln in festen Reihen (Subgrid, damit Label,
// Wert, Veränderung und Notiz reihenweise exakt fluchten) und darunter
// der interaktive Verlaufs-Chart für Indizes, SAP, Rohstoffe und Devisen.
import Emblem from "./Emblem.astro";
import KursChart from "./KursChart.astro";

interface Props {
  tiles: any[];
  stand?: string;
  history?: any;
}
const { tiles, stand, history } = Astro.props;
const arrow = { up: "▲", down: "▼", flat: "◆" };
// Auf dem Desktop sechs Spalten. Ist die letzte Reihe nicht voll, nimmt die
// letzte Kachel die Restspalten ein, statt eine Leerfläche zu lassen.
const rest = tiles.length % 6;
const restSpan = rest === 0 ? 1 : 6 - rest + 1;
---

<section class="marktpanel" aria-label="Märkte im Überblick">
  <div class="marktpanel__kopf">
    <Emblem name="maerkte" size={44} class="marktpanel__bild" />
    <div>
      <h2 class="marktpanel__titel">Märkte im Überblick</h2>
      {stand && <p class="marktpanel__stand">{stand}</p>}
    </div>
  </div>
  <div class="marktkacheln">
    {tiles.map((t, i) => (
      <div class={`kachel${i === tiles.length - 1 && restSpan > 1 ? " kachel--rest" : ""}`} style={i === tiles.length - 1 && restSpan > 1 ? `--rest-span: ${restSpan}` : undefined}>
        <span class="kachel__label">{t.label}</span>
        <span class="kachel__wert">{t.approx && <span class="kachel__ca">ca.</span>}{t.value}</span>
        <span class={t.delta ? `kachel__delta kachel__delta--${t.direction}` : "kachel__delta kachel__delta--leer"}>
          {t.delta ? `${arrow[t.direction]} ${t.delta}` : " "}
        </span>
        <span class="kachel__note">{t.note ?? ""}</span>
      </div>
    ))}
  </div>
  {history && (
    <div class="marktpanel__chart">
      <KursChart
        id="markt-verlauf"
        titel="Verlauf: Indizes, SAP, Rohstoffe, Devisen"
        untertitel="Instrument und Zeitraum wählen. Überfahren zeigt Datum, Wert und Veränderung."
        reihen={history.reihen}
        spanne="1J"
        format="breit"
      />
    </div>
  )}
</section>
