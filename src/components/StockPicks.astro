---
// Drei Aktien als Karten. Die Abschnitte liegen per Subgrid auf gemeinsamen
// Zeilenspuren: These, Markteinordnung, Gegenargumente usw. beginnen in allen
// drei Karten auf exakt derselben Höhe, egal wie lang der Text davor ist.
import LogoChip from "./LogoChip.astro";
import KursChart from "./KursChart.astro";

interface Props {
  picks: any[];
}
const { picks } = Astro.props;
---

<div class="picks-grid">
  {picks.map((p) => (
    <section class="karte pick" aria-label={`Fallstudie ${p.name}`}>
      <div class="pick__kopf">
        <LogoChip logoKey={p.logoKey} name={p.name} />
        <div>
          <h3>{p.name}</h3>
          <span class="pick__cap">{p.ticker} · Börsenwert {p.marketCapEUR}</span>
        </div>
      </div>
      <p class="pick__was">{p.whatTheyDo ?? ""}</p>
      <div class="pick__chart">
        {p.priceSeries && p.priceSeries.length > 1 && (
          <KursChart
            id={`pick-${p.ticker}`}
            titel="Kursverlauf"
            reihen={[{ label: p.name, unit: p.priceUnit ?? "", source: p.priceSeriesSource ?? "Kursdaten siehe Quellen", series: p.priceSeries }]}
            spanne="1J"
            format="kompakt"
          />
        )}
      </div>
      <div class="pick__abschnitt">
        <strong>These</strong>
        {p.thesis}
      </div>
      <div class="pick__abschnitt">
        {p.marktEinordnung && (
          <>
            <strong>Markteinordnung</strong>
            {p.marktEinordnung}
          </>
        )}
      </div>
      <div class="pick__abschnitt">
        <strong>Die stärksten Gegenargumente</strong>
        <ul>{p.counterarguments.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div class="pick__abschnitt">
        <strong>Katalysatoren</strong>
        <ul>{p.catalysts.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div class="pick__abschnitt pick__quelle">
        <strong>Quelle Börsenwert</strong>
        {p.capSource}
      </div>
    </section>
  ))}
</div>
<p class="hinweiszeile">Analyse-Fallstudien zu Lernzwecken. Keine Kauf-, Verkaufs- oder Halteempfehlung.</p>
