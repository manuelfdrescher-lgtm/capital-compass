---
// Rubrik-Bild im Kupferstich-Stil des Logos (public/images/rubriken/).
// Weißer Bildgrund verschmilzt per Blend-Modus mit dem Papier.
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 64, class: cls = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<img class={`emblem ${cls}`.trim()} src={`${base}/images/rubriken/${name}.png`} alt="" width={size} height={size} loading="lazy" decoding="async" aria-hidden="true" />
