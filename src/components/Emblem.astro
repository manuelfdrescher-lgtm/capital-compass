---
// Rubrik-Bild im Kupferstich-Stil des Logos (public/images/rubriken/).
// Transparente Tinte, verschmilzt ohne Kasten mit dem Papier.
interface Props {
  name: string;
  size?: number;
  class?: string;
  laden?: "lazy" | "eager";
}
const { name, size = 64, class: cls = "", laden = "lazy" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<img class={`emblem ${cls}`.trim()} src={`${base}/images/rubriken/${name}.png`} alt="" width={size} height={size} loading={laden} decoding="async" aria-hidden="true" />
