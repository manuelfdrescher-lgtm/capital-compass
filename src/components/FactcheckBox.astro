---
import Emblem from "./Emblem.astro";
interface Props {
  factcheck: any; // { claim, verdict, evidence }
}
const { factcheck } = Astro.props;
const mod =
  factcheck.verdict === "bestätigt"
    ? "bestaetigt"
    : factcheck.verdict === "unsicher"
      ? "unsicher"
      : "ungeprueft";
---

<aside class={`factcheck-box factcheck-box--${mod}`}>
  <span class="factcheck-box__titel"><Emblem name="faktencheck" size={30} class="box-bild" />Fact Check <span class="factcheck-box__verdict">{factcheck.verdict}</span></span>
  <p class="factcheck-box__claim">„{factcheck.claim}“</p>
  <p class="factcheck-box__beleg"><strong>Beleg:</strong> {factcheck.evidence}</p>
</aside>
