---
// Hantel-Diagramm (McKinsey-Stil) für die 11 Sektoren: je Zeile ein leerer
// Punkt für die letzte Woche und ein voller Punkt für den letzten Monat,
// verbunden durch eine Linie. Sortiert nach dem Monat, nur die zwei besten
// und die zwei schwächsten Sektoren sind farbig. Die Überschrift nennt
// die Kernaussage.
import { prozentKurz } from "../lib/sektoren.mjs";

interface Props {
  zeilen: { sektor: string; w1: number; m1: number }[];
  stand: string;
  quelle: string;
  markt?: { w1: number; m1: number } | null; // S&P 500 als Maßstab
}
const { zeilen, stand, quelle, markt = null } = Astro.props;
const rows = [...zeilen].sort((a, b) => b.m1 - a.m1);
const n = rows.length;
const top = rows.slice(0, 2).map((r) => r.sektor);
const flop = rows.slice(-2).map((r) => r.sektor);
const letzter = rows[n - 1];
const aussage =
  letzter.m1 < 0
    ? `${rows[0].sektor} und ${rows[1].sektor} führen den Monat an, ${letzter.sektor} verliert ${prozentKurz(letzter.m1).replace("−", "")}`
    : `${rows[0].sektor} und ${rows[1].sektor} führen den Monat an, ${letzter.sektor} liegt mit ${prozentKurz(letzter.m1)} hinten`;

// Zwei Varianten: breit (Label links) und schmal (Label über der Zeile).
function bau(W: number, oben: boolean) {
  const rowH = oben ? 50 : 34;
  const padTop = 6;
  const achseH = 30;
  const H = padTop + n * rowH + achseH;
  const werte = [...rows.flatMap((r) => [r.w1, r.m1, 0]), ...(markt ? [markt.m1] : [])];
  const min = Math.min(...werte);
  const max = Math.max(...werte);
  const plotX = oben ? 62 : 250;
  const plotW = W - plotX - (oben ? 62 : 60);
  const span = max - min || 1;
  const xVon = (v: number) => plotX + ((v - min) / span) * plotW;
  const roh = span / (oben ? 3 : 5);
  const pot = Math.pow(10, Math.floor(Math.log10(roh)));
  const schritt = [1, 2, 2.5, 5, 10].map((f) => f * pot).find((x) => x >= roh) ?? 10 * pot;
  const ticks: number[] = [];
  for (let v = Math.ceil(min / schritt) * schritt; v <= max + 1e-9; v += schritt) ticks.push(Number(v.toPrecision(10)));
  const zeilen = rows.map((r, i) => {
    const y = padTop + i * rowH + (oben ? rowH - 14 : rowH / 2);
    const xw = xVon(r.w1);
    const xm = xVon(r.m1);
    const rechts = xm >= xw;
    return {
      ...r, i, y, xw, xm, rechts,
      labelY: oben ? y - 16 : y + 5,
      wertX: rechts ? Math.max(xm, xw) + 12 : Math.min(xm, xw) - 12,
      art: top.includes(r.sektor) ? "plus" : flop.includes(r.sektor) ? "minus" : "grau",
    };
  });
  return { W, H, padTop, achseH, xVon, ticks, zeilen, rowH, oben, marktX: markt ? xVon(markt.m1) : null };
}
const varianten = [
  { klasse: "grafik__svg--breit", g: bau(760, false) },
  { klasse: "grafik__svg--schmal", g: bau(400, true) },
];
const kurz = (v) => `${v > 0 ? "+" : ""}${new Intl.NumberFormat("de-DE", { maximumFractionDigits: 1 }).format(v)} %`;
---

<figure class="chart grafik grafik--punkte grafik--hantel" data-einblenden aria-label={`Grafik: ${aussage}`}>
  <figcaption class="grafik__kopf">
    <span class="grafik__kicker">Grafik · Sektoren im Vergleich</span>
    <span class="chart__titel">{aussage}</span>
    <span class="chart__untertitel">Gesamtrendite der US-Sektorfonds inklusive Dividenden in Prozent, sortiert nach dem letzten Monat</span>
    <span class="hantel__legende"><span class="hantel__woche"></span>letzte Woche <span class="hantel__monat"></span>letzter Monat{markt && <><span class="hantel__marktlinie"></span>Gesamtmarkt S&P 500 im Monat: {prozentKurz(markt.m1)}</>}</span>
  </figcaption>
  {varianten.map(({ klasse, g }) => (
    <svg class={`grafik__svg ${klasse}`} viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-label={`${aussage}. ${rows.map((r) => `${r.sektor}: Woche ${prozentKurz(r.w1)}, Monat ${prozentKurz(r.m1)}`).join("; ")}`}>
      {g.ticks.map((v) => (
        <g>
          <line class={v === 0 ? "achse achse--null" : "gitter"} x1={g.xVon(v)} x2={g.xVon(v)} y1={g.padTop - 2} y2={g.H - g.achseH + 4} />
          <text class="achsenlabel" x={g.xVon(v)} y={g.H - 8} text-anchor="middle">{kurz(v)}</text>
        </g>
      ))}
      {g.marktX !== null && (
        <g class="hantel__markt">
          <line x1={g.marktX} x2={g.marktX} y1={g.padTop - 2} y2={g.H - g.achseH + 4} />
        </g>
      )}
      {g.zeilen.map((z) => (
        <g class={`punkt-zeile punkt-zeile--${z.art}`} style={`--i: ${z.i}`}>
          <title>{z.sektor}: Woche {prozentKurz(z.w1)}, Monat {prozentKurz(z.m1)}</title>
          <rect class="zeilen-band" x="0" y={g.padTop + z.i * g.rowH} width={g.W} height={g.rowH} />
          <text class="balken-label" x="0" y={z.labelY}>{z.sektor}</text>
          <line class="hantel__steg" x1={Math.min(z.xw, z.xm)} x2={Math.max(z.xw, z.xm)} y1={z.y} y2={z.y} />
          <circle class="hantel__punkt-woche" cx={z.xw} cy={z.y} r="5.5" />
          <circle class="punkt" cx={z.xm} cy={z.y} r="7" />
          <text class="wertlabel" x={z.wertX} y={z.y + 5} text-anchor={z.rechts ? "start" : "end"}>{prozentKurz(z.m1)}</text>
        </g>
      ))}
    </svg>
  ))}
  <p class="chart__quelle">Quelle: {quelle}, Schlusskurse bis {stand}</p>
</figure>
