---
import "@fontsource/playfair-display/600.css";
import "@fontsource/playfair-display/700.css";
import "@fontsource/playfair-display/800.css";
import "@fontsource-variable/source-serif-4";
import "@fontsource/barlow-condensed/400.css";
import "@fontsource/barlow-condensed/500.css";
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/special-elite/400.css";
import "../styles/global.css";
import { existsSync } from "node:fs";
import { join } from "node:path";
import CompassRose from "../components/CompassRose.astro";
import MastheadLogo from "../components/MastheadLogo.astro";
import RubrikDock from "../components/RubrikDock.astro";
import Vorspann from "../components/Vorspann.astro";
import { formatDateLong, slotLabel } from "../lib/format.mjs";
import { logoInfo } from "../lib/logo.mjs";

// Eigenes Marken-Logo (Vollversion mit Wortmarke) hat Vorrang: dann wird die
// Text-Wortmarke im Kopf durch das Bild ersetzt.
const logoFile = ["masthead-logo.png", "masthead-logo.svg", "masthead-logo.jpg"].find((f) =>
  existsSync(join(process.cwd(), "public", "images", f))
);
const logo = logoFile ? logoInfo(logoFile) : null;

interface Props {
  title: string;
  description?: string;
  active?: string;
  edition?: any; // Editions-Metadaten für Datumszeile und Beispiel-Banner
}

const { title, description, active = "", edition } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const nav = [
  { href: `${base}/`, key: "titelseite", label: "Titelseite", bild: "topthemen" },
  { href: `${base}/news/`, key: "news", label: "News", bild: "news" },
  { href: `${base}/politik/`, key: "politik", label: "Politik", bild: "politik" },
  { href: `${base}/branchen-monitor/`, key: "branchen-monitor", label: "Branchen-Monitor", bild: "branchen" },
  { href: `${base}/unternehmen/`, key: "unternehmen", label: "Unternehmen", bild: "unternehmen" },
  { href: `${base}/drei-aktien/`, key: "drei-aktien", label: "Drei Aktien", bild: "aktien" },
  { href: `${base}/lernecke/`, key: "lernecke", label: "Lernecke", bild: "lernecke" },
  { href: `${base}/archiv/`, key: "archiv", label: "Archiv", bild: "archiv" },
];
// Handy: die Rubriken stehen in zwei Zeilen, umbrochen nach der Hälfte
const navHalb = Math.ceil(nav.length / 2);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · The Capital Compass</title>
    <meta name="description" content={description ?? "The Capital Compass: a daily briefing on markets, business and the global economy. Bildung, keine Anlageberatung."} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline define:vars={{ base }}>
      document.documentElement.classList.add("js-an");
      // Vorspann einmal pro Sitzung; nicht bei reduzierter Bewegung und nicht in automatisierten Tests
      // (?vorspann in der Adresse spielt ihn erneut ab)
      try {
        var nochmal = /[?&]vorspann\b/.test(location.search);
        if (nochmal || (!navigator.webdriver && !sessionStorage.getItem("cc-vorspann") && !matchMedia("(prefers-reduced-motion: reduce)").matches)) {
          document.documentElement.classList.add("vorspann-an");
          // Federhand und Kompass zuerst laden: Damit beginnt der Film. Der Rest lädt während des Zeichnens.
          ["hand-feder.webp", "kompass.webp"].forEach(function (f) {
            var l = document.createElement("link");
            l.rel = "preload"; l.as = "image"; l.href = base + "/images/vorspann/" + f;
            l.setAttribute("fetchpriority", "high");
            document.head.appendChild(l);
          });
          // Notausgang: Läuft der Film nach 3,5 Sekunden noch nicht, erscheint die Seite ohne ihn
          setTimeout(function () {
            if (!document.documentElement.classList.contains("vorspann-film")) document.documentElement.classList.remove("vorspann-an");
          }, 3500);
          // Ein Klick auf die Wartefläche vor dem Filmstart zeigt die Seite sofort
          document.addEventListener("click", function () {
            if (!document.documentElement.classList.contains("vorspann-film")) document.documentElement.classList.remove("vorspann-an");
          }, { once: true });
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <Vorspann />
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <div class="seite">
      <header class="masthead">
        {logoFile ? (
          <a href={`${base}/`} class="masthead__marke" aria-label="The Capital Compass — zur Titelseite">
            <img class="masthead__marke-img" src={`${base}/images/${logoFile}?v=${logo.version}`} width={logo.width} height={logo.height} alt="The Capital Compass — A Daily Briefing on Markets, Business and the Global Economy" />
          </a>
        ) : (
          <>
            <MastheadLogo width={210} />
            <p class="masthead__the">The</p>
            <p class="masthead__titel"><a href={`${base}/`}>Capital Compass</a></p>
            <p class="masthead__tagline">A Daily Briefing on Markets, Business and the Global Economy</p>
          </>
        )}
        <p class="masthead__leser">für Manuel Drescher</p>
        <div class="masthead__doppel" role="presentation"></div>
        {edition && (
          <p class="datumszeile">
            <span>{formatDateLong(edition.date)}</span>
          </p>
        )}
        <nav class="hauptnav" aria-label="Ressorts" data-hauptnav>
          <div class="hauptnav__leiste">
          {nav.slice(0, navHalb).map((item) => (
            <a href={item.href} aria-current={active === item.key ? "page" : undefined}>
              <span class="hauptnav__text">{item.label}</span>
              <img class="hauptnav__bild" src={`${base}/images/rubriken/leiste/${item.bild}.png`} alt="" width="68" height="68" decoding="async" aria-hidden="true" />
            </a>
          ))}
          <span class="hauptnav__umbruch" aria-hidden="true"></span>
          {nav.slice(navHalb).map((item) => (
            <a href={item.href} aria-current={active === item.key ? "page" : undefined}>
              <span class="hauptnav__text">{item.label}</span>
              <img class="hauptnav__bild" src={`${base}/images/rubriken/leiste/${item.bild}.png`} alt="" width="68" height="68" decoding="async" aria-hidden="true" />
            </a>
          ))}
          </div>
        </nav>
        {edition?.isExample && (
          <p class="beispiel-banner">Beispiel-Ausgabe mit erfundenen Demodaten. Keine echten Kurse, keine echten Nachrichten.</p>
        )}
      </header>

      <RubrikDock active={active} />

      <main id="inhalt">
        <slot />
      </main>

      <footer class="fusszeile">
        <div class="fusszeile__kopf">
          <CompassRose class="fusszeile__kompass" size={30} />
          <p class="fusszeile__claim">Insight · Context · Perspective</p>
        </div>
        <p><strong>Wichtiger Hinweis:</strong> The Capital Compass dient ausschließlich der Bildung und dem Kapitalmarktverständnis. Es ist keine Anlageberatung. Es gibt keine Kauf-, Verkaufs- oder Halteempfehlungen und keine Trading-Signale. Chancen und Risiken werden nur als analytische Lernpunkte dargestellt.</p>
        <p>Jede Zahl dieser Ausgabe ist vor Veröffentlichung gegen unabhängige Quellen geprüft. Quellen mit Tier-Kennzeichnung stehen an jedem Artikel. Unternehmenslogos: Wikimedia Commons, Markenrechte bei den jeweiligen Unternehmen. „Ein Kurs bewegt sich mit der Differenz zwischen Nachricht und Erwartung.“</p>
      </footer>
    </div>
    <script>
      // Grafiken bauen sich auf, sobald sie ins Bild kommen. Der Ausgangs-
      // zustand steht im CSS (.js-an), damit beim Laden nichts flackert.
      const ziele = document.querySelectorAll<HTMLElement>("[data-einblenden]");
      const zeigen = (el: Element) => el.classList.add("gezeigt");
      if ("IntersectionObserver" in window) {
        const beobachter = new IntersectionObserver((eintraege) => {
          for (const e of eintraege) {
            if (e.isIntersecting) {
              zeigen(e.target);
              beobachter.unobserve(e.target);
            }
          }
        }, { threshold: 0.2 });
        ziele.forEach((el) => beobachter.observe(el));
      } else {
        ziele.forEach(zeigen);
      }
      window.addEventListener("beforeprint", () => ziele.forEach(zeigen));

      // Vergleichs-Grafiken: Antippen (Handy) oder Klick hebt eine Reihe hervor.
      document.querySelectorAll<SVGSVGElement>(".grafik--punkte svg").forEach((svg) => {
        svg.addEventListener("click", (e) => {
          const zeile = (e.target as Element).closest(".punkt-zeile");
          const aktiv = zeile?.classList.contains("ist-aktiv");
          svg.querySelectorAll(".punkt-zeile").forEach((z) => z.classList.remove("ist-aktiv"));
          if (zeile && !aktiv) zeile.classList.add("ist-aktiv");
          svg.classList.toggle("hat-fokus", !!zeile && !aktiv);
        });
      });

      // Navigation: Auf dem Rechner wechselt beim Überfahren die Schrift zum
      // Rubrik-Bild (reines CSS). Auf dem Handy zeigt ein Tippen kurz das
      // Bild, dann öffnet sich die Rubrik.
      const hauptnav = document.querySelector<HTMLElement>("[data-hauptnav]");
      if (hauptnav) {
        const links = [...hauptnav.querySelectorAll<HTMLAnchorElement>("a")];
        const ruhig = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const maus = matchMedia("(hover: hover) and (pointer: fine)");
        // Touch: Tippen zeigt kurz das Bild, dann öffnet sich die Rubrik
        links.forEach((a) => a.addEventListener("click", (ev) => {
          if (ruhig || maus.matches || ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
          ev.preventDefault();
          a.classList.add("ist-gedrueckt");
          setTimeout(() => { location.href = a.href; }, 320);
        }));
        window.addEventListener("pageshow", () => links.forEach((a) => a.classList.remove("ist-gedrueckt")));
        // Handy: die aktuelle Rubrik in die Mitte der Leiste holen und die
        // Ränder dort weich ausblenden, wo noch Rubriken folgen
        const leiste = hauptnav.querySelector<HTMLElement>(".hauptnav__leiste")!;
        const aktuell = leiste.querySelector<HTMLElement>('[aria-current="page"]');
        if (aktuell && leiste.scrollWidth > leiste.clientWidth) {
          leiste.scrollLeft = aktuell.offsetLeft - (leiste.clientWidth - aktuell.offsetWidth) / 2;
        }
        let raender = 0;
        const raenderSetzen = () => {
          const rest = leiste.scrollWidth - leiste.clientWidth - leiste.scrollLeft;
          leiste.classList.toggle("mehr-links", leiste.scrollLeft > 2);
          leiste.classList.toggle("mehr-rechts", rest > 2);
        };
        leiste.addEventListener("scroll", () => {
          cancelAnimationFrame(raender);
          raender = requestAnimationFrame(raenderSetzen);
        }, { passive: true });
        window.addEventListener("resize", raenderSetzen);
        raenderSetzen();
      }
    </script>
  </body>
</html>
